{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
      "^Ink(.*)": "@/components/Ink$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundColorTop": "#F7F2E9"
      }
    },
    {
      "path": "pages/search/search",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/item/detail",
      "style": {
        "navigationBarTitleText": "时装详情",
        "navigationBarBackgroundColor": "#F7F2E9",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/outfit/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/outfit/detail",
      "style": {
        "navigationBarTitleText": "搭配详情",
        "navigationBarBackgroundColor": "#F7F2E9",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/outfit/create",
      "style": {
        "navigationBarTitleText": "新建搭配",
        "navigationBarBackgroundColor": "#F7F2E9",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/mine/favorite",
      "style": {
        "navigationBarTitleText": "我的收藏",
        "navigationBarBackgroundColor": "#F7F2E9",
        "navigationBarTextStyle": "black",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/mine/outfits",
      "style": {
        "navigationBarTitleText": "我的搭配",
        "navigationBarBackgroundColor": "#F7F2E9",
        "navigationBarTextStyle": "black",
        "enablePullDownRefresh": true
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "燕云十六声",
    "navigationBarBackgroundColor": "#F7F2E9",
    "backgroundColor": "#F7F2E9",
    "backgroundColorTop": "#F7F2E9",
    "backgroundColorBottom": "#F7F2E9"
  },
  "tabBar": {
    "color": "#918780",
    "selectedColor": "#A6322A",
    "backgroundColor": "#FDFBF7",
    "borderStyle": "white",
    "fontSize": "11px",
    "iconWidth": "22px",
    "spacing": "4px",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "图鉴",
        "iconPath": "static/tabbar/book.png",
        "selectedIconPath": "static/tabbar/book-active.png"
      },
      {
        "pagePath": "pages/outfit/index",
        "text": "搭配",
        "iconPath": "static/tabbar/robe.png",
        "selectedIconPath": "static/tabbar/robe-active.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "static/tabbar/user.png",
        "selectedIconPath": "static/tabbar/user-active.png"
      }
    ]
  }
}
