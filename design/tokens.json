{
  "$meta": {
    "name": "燕云十六声 · 古风时装搭配 设计令牌",
    "version": "1.0.0",
    "note": "单一事实来源。修改后执行 `pnpm tokens` 同步生成 admin 的 CSS 变量与 miniapp 的 SCSS 变量。"
  },
  "color": {
    "ink": { "900": "#100E0C", "800": "#1B1815", "700": "#2A2521", "600": "#3A332D", "500": "#514840", "400": "#6E645B", "300": "#918780", "200": "#B7ADA4", "100": "#D9D0C6", "50": "#EDE8E3" },
    "paper": { "50": "#FDFBF7", "100": "#F7F2E9", "200": "#EFE7D9", "300": "#E3D8C6", "400": "#D2C3AC" },
    "cinnabar": { "600": "#8A2A21", "500": "#A6322A", "400": "#C0443C", "300": "#D96B62", "100": "#F7E5E2" },
    "gold": { "600": "#8A6A32", "500": "#B08A45", "400": "#C9A063", "300": "#E0C99A", "100": "#F6EEDF" },
    "jade": { "600": "#47655C", "500": "#5F837A", "400": "#86A79E", "100": "#E4EDEA" },
    "indigo": { "600": "#2B3947", "500": "#38485A", "400": "#55697D", "100": "#E3E8EE" },
    "ochre": { "600": "#7A4A2E", "500": "#9A6238", "400": "#B88154", "100": "#F2E3D6" },
    "purple": { "600": "#4E2F44", "500": "#6B4159", "400": "#8C5C74", "100": "#EFE3EA" },
    "bamboo": { "600": "#3F5A45", "500": "#56755A", "400": "#7B9878", "100": "#E5EDE3" },
    "moon": { "600": "#7E8A94", "500": "#9AA6AF", "400": "#BCC6CC", "100": "#F0F3F4" }
  },
  "semantic": {
    "bg": "#F7F2E9",
    "bgSubtle": "#FDFBF7",
    "surface": "#FFFDF9",
    "surfaceRaised": "#FFFFFF",
    "surfaceInverse": "#1B1815",
    "textPrimary": "#1B1815",
    "textSecondary": "#514840",
    "textTertiary": "#6E645B",
    "textPlaceholder": "#918780",
    "textInverse": "#F7F2E9",
    "border": "rgba(27,24,21,0.10)",
    "borderStrong": "rgba(27,24,21,0.18)",
    "divider": "rgba(27,24,21,0.07)",
    "accent": "#A6322A",
    "accentHover": "#8A2A21",
    "accentSoft": "#F7E5E2",
    "gold": "#B08A45",
    "goldSoft": "#F6EEDF",
    "success": "#47655C",
    "warning": "#9A6238",
    "danger": "#A6322A",
    "info": "#38485A"
  },
  "rarity": {
    "common": { "label": "凡品", "color": "#7E8A94", "bg": "#F0F3F4", "border": "#D6DDE1" },
    "fine": { "label": "良品", "color": "#47655C", "bg": "#E4EDEA", "border": "#BFD3CD" },
    "rare": { "label": "珍品", "color": "#38485A", "bg": "#E3E8EE", "border": "#C2CCD8" },
    "epic": { "label": "绝品", "color": "#8A6A32", "bg": "#F6EEDF", "border": "#E4D2AC" },
    "legend": { "label": "传说", "color": "#A6322A", "bg": "#F7E5E2", "border": "#EBC3BF" }
  },
  "font": {
    "display": "\"Songti SC\", \"STSong\", \"Source Han Serif SC\", \"Noto Serif SC\", \"SimSun\", serif",
    "body": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", \"Helvetica Neue\", Arial, sans-serif",
    "mono": "\"JetBrains Mono\", \"SFMono-Regular\", Consolas, monospace"
  },
  "fontSize": {
    "xs": 12,
    "sm": 13,
    "base": 14,
    "md": 16,
    "lg": 18,
    "xl": 20,
    "2xl": 24,
    "3xl": 30,
    "4xl": 38
  },
  "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
  "lineHeight": { "tight": 1.2, "snug": 1.35, "normal": 1.55, "relaxed": 1.75 },
  "letterSpacing": { "tighter": "-0.01em", "normal": "0", "wide": "0.04em", "wider": "0.12em", "widest": "0.24em" },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "14": 56, "18": 72 },
  "radius": { "xs": 2, "sm": 4, "md": 8, "lg": 12, "xl": 16, "2xl": 24, "pill": 999 },
  "shadow": {
    "xs": "0 1px 2px rgba(27,24,21,0.05)",
    "sm": "0 2px 8px -2px rgba(27,24,21,0.08)",
    "md": "0 6px 20px -8px rgba(27,24,21,0.16)",
    "lg": "0 16px 44px -16px rgba(27,24,21,0.22)",
    "ink": "0 24px 60px -24px rgba(16,14,12,0.45)"
  },
  "motion": {
    "fast": "140ms",
    "base": "220ms",
    "slow": "380ms",
    "slower": "640ms",
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)",
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "zIndex": { "base": 0, "sticky": 10, "overlay": 100, "dropdown": 200, "modal": 1000, "toast": 2000 },
  "layout": {
    "maxContentWidth": 1280,
    "sidebarWidth": 216,
    "sidebarCollapsedWidth": 64,
    "headerHeight": 56,
    "mobileGutter": 16,
    "designWidth": 750
  }
}
